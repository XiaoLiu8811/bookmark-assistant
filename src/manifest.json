{
  "manifest_version": 3,
  "name": "Bookmark Assistant",
  "version": "0.1.0",
  "description": "Shows your matching bookmarks beside Google results, so what you saved comes first. Your bookmarks stay on your device.",
  "permissions": ["bookmarks", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["filled in by build.mjs from src/google-domains.json"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Bookmark Assistant",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https:"
  }
}
